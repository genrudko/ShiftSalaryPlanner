<?xml version="1.0" encoding="utf-8"?>
<!-- Preserve system device-transfer behavior; require device encryption capability
     before Android's independent OS cloud backup of payroll/Notes data.
     App-owned ZIP/Google Drive backup is separately managed by the user. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true" />
    <device-transfer />
</data-extraction-rules>
