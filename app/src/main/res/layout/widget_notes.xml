<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetNotesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_month_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetNotesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Заметки"
                android:textColor="#F7F9FF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetNotesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#AEB8D8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetNotesOpenApp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Открыть"
            android:textColor="#8FEAD7"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetNoteRow1"
        android:background="@drawable/widget_note_card_bg"
        style="@style/WidgetNoteRowStyle">
        <TextView
            android:id="@+id/widgetNoteStripe1"
            style="@style/WidgetNoteStripeStyle" />
        <LinearLayout style="@style/WidgetNoteTextColumnStyle">
            <TextView
                android:id="@+id/widgetNoteTitle1"
                style="@style/WidgetNoteTitleStyle" />
            <TextView
                android:id="@+id/widgetNoteBody1"
                style="@style/WidgetNoteBodyStyle" />
            <TextView
                android:id="@+id/widgetNoteMeta1"
                style="@style/WidgetNoteMetaStyle" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetNoteRow2"
        android:background="@drawable/widget_note_card_bg"
        style="@style/WidgetNoteRowStyle">
        <TextView
            android:id="@+id/widgetNoteStripe2"
            style="@style/WidgetNoteStripeStyle" />
        <LinearLayout style="@style/WidgetNoteTextColumnStyle">
            <TextView
                android:id="@+id/widgetNoteTitle2"
                style="@style/WidgetNoteTitleStyle" />
            <TextView
                android:id="@+id/widgetNoteBody2"
                style="@style/WidgetNoteBodyStyle" />
            <TextView
                android:id="@+id/widgetNoteMeta2"
                style="@style/WidgetNoteMetaStyle" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetNoteRow3"
        android:background="@drawable/widget_note_card_bg"
        style="@style/WidgetNoteRowStyle">
        <TextView
            android:id="@+id/widgetNoteStripe3"
            style="@style/WidgetNoteStripeStyle" />
        <LinearLayout style="@style/WidgetNoteTextColumnStyle">
            <TextView
                android:id="@+id/widgetNoteTitle3"
                style="@style/WidgetNoteTitleStyle" />
            <TextView
                android:id="@+id/widgetNoteBody3"
                style="@style/WidgetNoteBodyStyle" />
            <TextView
                android:id="@+id/widgetNoteMeta3"
                style="@style/WidgetNoteMetaStyle" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widgetNotesEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Пока нет заметок"
        android:textColor="#D7DDF1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
